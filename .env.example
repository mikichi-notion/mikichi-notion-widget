# Notion インテグレーションのシークレット
# https://www.notion.so/my-integrations で取得
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# サーバーポート (デフォルト: 3000)
PORT=3000

# 検索を許可するデータベース (カンマ区切りのDB ID)
# 例: NOTION_DB_IDS=abc123,def456
# 空欄の場合はインテグレーションがアクセスできる全DBを表示
NOTION_DB_IDS=

# CORS オリジン (デフォルト: * = 全許可)
# 本番環境ではデプロイ先URLに変更: https://your-widget.railway.app
ALLOWED_ORIGIN=*
